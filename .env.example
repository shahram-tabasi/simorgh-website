# Copy to .env.local on the server and fill in. Restart the site after changing it.

# Admin panel (/admin). The panel stays locked until ADMIN_PASSWORD (8+ characters) is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional: a long random string that signs admin sessions. Changing it logs everyone out.
ADMIN_SECRET=

# The public address of the site: canonical links, sitemap.xml and social cards use it.
NEXT_PUBLIC_SITE_URL=https://www.simorghai.com

# Where admin content, uploads, backups and form submissions are kept (default: ./storage).
# Back this folder up.
# SIMORGH_STORAGE_DIR=

# Optional: AI chat and on-the-fly translation of new text.
OPENAI_API_KEY=

# ── Company email (see docs/EMAIL-SETUP.fa.md) ───────────────────────────────
MAIL_DOMAIN=simorghai.com
MAIL_HOST=mail.simorghai.com
# The server's public IP (for the DNS records page in the admin panel).
MAIL_SERVER_IP=
# mailcow's web/API address as seen from the site, and a read-write API key.
MAILCOW_URL=http://127.0.0.1:8080
MAILCOW_API_KEY=
# Where /mail sends people (default: https://<MAIL_HOST>/SOGo/).
WEBMAIL_URL=https://mail.simorghai.com/SOGo/
# Contact / demo-request notifications are sent through this mailbox.
SMTP_HOST=mail.simorghai.com
SMTP_PORT=587
SMTP_USER=noreply@simorghai.com
SMTP_PASS=
